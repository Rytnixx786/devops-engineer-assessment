{
  "title": "Containers",
  "uid": "assessment-containers",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "CPU by container",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum by(name)(rate(container_cpu_usage_seconds_total{name!=\"\",container_label_com_docker_compose_project=\"devops-assessment\"}[2m]))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 2,
      "title": "Working set by container",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "max by(name)(container_memory_working_set_bytes{name!=\"\",container_label_com_docker_compose_project=\"devops-assessment\"})",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 3,
      "title": "Memory limit used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "100 * max by(name)(container_memory_working_set_bytes{name!=\"\",container_label_com_docker_compose_project=\"devops-assessment\"}) / max by(name)(container_spec_memory_limit_bytes{name!=\"\",container_label_com_docker_compose_project=\"devops-assessment\"} > 0 and container_spec_memory_limit_bytes < 1e18)",
          "legendFormat": ""
        }
      ]
    }
  ]
}
