#!/usr/bin/env bash
set -euo pipefail
dnf install -y docker jq
systemctl enable --now docker amazon-ssm-agent
install -m 0600 /dev/null /etc/assessment-release.env
cat >/etc/assessment-release.env <<'CONFIG'
REGION=${region}
APP_ENV=${env}
REPOSITORY=${repo}
LOG_GROUP=${group}
CONFIG
echo '${deploy}' | base64 -d >/usr/local/sbin/assessment-deploy
chmod 0755 /usr/local/sbin/assessment-deploy
for attempt in {1..6}; do
  if /usr/local/sbin/assessment-deploy '${tag}'; then exit 0; fi
  sleep 10
done
exit 1
